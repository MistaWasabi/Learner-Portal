// ===============================================================
// Assumed Data Model
// ===============================================================
// Collection: users/{userId}/documents/{documentId}
// Fields: name (string, 1-120), url (HTTPS string, 1-2,000), createdAt
// (server timestamp). Every record belongs only to the userId in its path.
// Collection: users/{userId}/tasks/{taskId}
// Fields: title (string, 1-120), category (string, 1-40), dueDate (YYYY-MM-DD
// string), priority (low/medium/high), completed (boolean), createdAt (timestamp,
// immutable after creation). Every task belongs only to the userId in its path.
// Collection: users/{userId}/courseSelections/{courseId}
// Fields: courseId (one of the application catalogue IDs and equal to the document
// ID), enrolledAt (recent server timestamp, immutable). Every selection belongs
// only to the userId in its path. Shared course content is not stored in Firestore
// in this first version, so learners cannot alter it.
// Collection: users/{userId}/lessonProgress/{courseId--lessonId}
// Fields: courseId and lessonId (a known valid course-and-lesson pair), completedAt
// (recent server timestamp, immutable). Every completion remains private to its owner.
// Collection: learnerProgress/{userId}
// Fields: displayName (public username, 1-50), selectedCourseCount (0-3),
// totalSelectedLessons (0-9), completedLessonCount (0-totalSelectedLessons),
// updatedAt (recent server timestamp). This intentionally contains no email or
// private lesson details and is readable by authenticated learners for now.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Checks that the request has a Firebase Auth identity.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Ensures the user can access only their own document-library path.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Roles come only from trusted Firebase Admin SDK Custom Claims, never from Firestore or React.
    function isProgressStaff() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'teacher');
    }

    // Included for future records that store a user ID; the current schemas use the path as ownership.
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    // Prevents a stored user ID from being changed if a future schema needs one.
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    // Applies the same strict schema checks every time a record is written.
    function isValidDocument() {
      return request.resource.data.keys().hasOnly([
          'name', 'url', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'name', 'url', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.url is string &&
        request.resource.data.url.size() > 0 && request.resource.data.url.size() <= 2000 &&
        request.resource.data.url.matches('^https://.*') &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.createdAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.createdAt <= request.time;
    }

    // Requires a predictable task schema on both creates and updates.
    function isValidTask() {
      return request.resource.data.keys().hasOnly([
          'title', 'category', 'dueDate', 'priority', 'completed', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'title', 'category', 'dueDate', 'priority', 'completed', 'createdAt'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40 &&
        request.resource.data.dueDate is string &&
        request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.priority in ['low', 'medium', 'high'] &&
        request.resource.data.completed is bool &&
        request.resource.data.createdAt is timestamp;
    }

    // Limits selections to the fixed course catalogue and blocks arbitrary data from being written.
    function isValidCourseSelection(courseId) {
      return request.resource.data.keys().hasOnly([
          'courseId', 'enrolledAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'courseId', 'enrolledAt'
        ]) &&
        request.resource.data.courseId is string &&
        request.resource.data.courseId == courseId &&
        request.resource.data.courseId in [
          'web-development-basics',
          'javascript-fundamentals',
          'professional-communication'
        ] &&
        request.resource.data.enrolledAt is timestamp &&
        request.resource.data.enrolledAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.enrolledAt <= request.time;
    }

    // Ensures a completion record refers to a real lesson in its matching predefined course.
    function isKnownCourseLesson(courseId, lessonId) {
      return (courseId == 'web-development-basics' && lessonId in [
          'html-foundations', 'css-layouts', 'responsive-design'
        ]) ||
        (courseId == 'javascript-fundamentals' && lessonId in [
          'variables-values', 'conditions-loops', 'functions-events'
        ]) ||
        (courseId == 'professional-communication' && lessonId in [
          'clear-messages', 'feedback', 'professional-email'
        ]);
    }

    // Completion documents deliberately hold one lesson each, avoiding an unvalidated client-written array.
    function isValidLessonProgress(progressId) {
      return request.resource.data.keys().hasOnly([
          'courseId', 'lessonId', 'completedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'courseId', 'lessonId', 'completedAt'
        ]) &&
        request.resource.data.courseId is string &&
        request.resource.data.lessonId is string &&
        isKnownCourseLesson(request.resource.data.courseId, request.resource.data.lessonId) &&
        progressId == request.resource.data.courseId + '--' + request.resource.data.lessonId &&
        request.resource.data.completedAt is timestamp &&
        request.resource.data.completedAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.completedAt <= request.time;
    }

    // Validates the small shared summary without placing private Auth information in a broadly readable document.
    function isValidLearnerProgress() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'selectedCourseCount', 'totalSelectedLessons',
          'completedLessonCount', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'displayName', 'selectedCourseCount', 'totalSelectedLessons',
          'completedLessonCount', 'updatedAt'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 50 &&
        request.resource.data.selectedCourseCount is int &&
        request.resource.data.selectedCourseCount >= 0 && request.resource.data.selectedCourseCount <= 3 &&
        request.resource.data.totalSelectedLessons is int &&
        request.resource.data.totalSelectedLessons >= 0 && request.resource.data.totalSelectedLessons <= 9 &&
        request.resource.data.completedLessonCount is int &&
        request.resource.data.completedLessonCount >= 0 &&
        request.resource.data.completedLessonCount <= request.resource.data.totalSelectedLessons &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.updatedAt <= request.time;
    }

    match /users/{userId}/documents/{documentId} {
      // A learner can list and open only their own document-link records.
      allow read: if isOwner(userId);

      // A new record must be owned by the learner and match the strict schema.
      allow create: if isOwner(userId) && isValidDocument();

      // This first version does not support record edits, preventing metadata tampering.
      allow update: if false;

      // A learner can remove only their own link record.
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/tasks/{taskId} {
      // A learner can list and view only the tasks stored in their own path.
      allow read: if isOwner(userId);

      // New tasks must be owned, fully valid, and created with a recent server timestamp.
      allow create: if isOwner(userId) && isValidTask() &&
        request.resource.data.createdAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.createdAt <= request.time;

      // Updates validate the whole future task document and protect its original creation date.
      allow update: if isOwner(userId) && isValidTask() &&
        request.resource.data.createdAt == resource.data.createdAt;

      // A learner can remove only a task located in their own path.
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/courseSelections/{courseId} {
      // A learner can read only the course IDs they have personally selected.
      allow read: if isOwner(userId);

      // A selection must use a known course ID and a recent server timestamp.
      allow create: if isOwner(userId) && isValidCourseSelection(courseId);

      // Learners remove and re-add a selection rather than altering its immutable enrolment data.
      allow update: if false;

      // A learner can remove only a course selection in their own Firestore path.
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/lessonProgress/{progressId} {
      // A learner can see only their own individual completion records.
      allow read: if isOwner(userId);

      // A completion must name one known lesson and use the predictable document ID created by the app.
      allow create: if isOwner(userId) && isValidLessonProgress(progressId);

      // Toggling completion uses delete-and-create, keeping completion timestamps immutable.
      allow update: if false;

      // A learner can mark only their own completion record incomplete.
      allow delete: if isOwner(userId);
    }

    match /learnerProgress/{userId} {
      // Only trusted staff claims may read every learner's shared progress summary.
      allow read: if isProgressStaff();

      // Only the owner can create or refresh their own public summary, and every write validates the whole schema.
      allow create: if isOwner(userId) && isValidLearnerProgress();
      allow update: if isOwner(userId) && isValidLearnerProgress();

      // The application has no delete action for the shared summary.
      allow delete: if false;
    }
  }
}
