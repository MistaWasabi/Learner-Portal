// ===============================================================
// Assumed Data Model
// ===============================================================
// Collection: users/{userId}/documents/{documentId}
// Fields: name (string, 1-120), storagePath (documents/{uid}/{documentId}),
// contentType (allow-listed MIME type), fileSize (1-10 MiB), createdAt (server
// timestamp). Every metadata record belongs only to the userId in its path.
// Collection: users/{userId}/tasks/{taskId}
// Fields: title (string, 1-120), category (string, 1-40), dueDate (YYYY-MM-DD
// string), priority (low/medium/high), completed (boolean), createdAt (timestamp,
// immutable after creation). Every task belongs only to the userId in its path.
// Collection: users/{userId}/courseSelections/{courseId}
// Fields: courseId (one of the application catalogue IDs and equal to the document
// ID), enrolledAt (recent server timestamp, immutable). Every selection belongs
// only to the userId in its path. Shared course content is not stored in Firestore
// in this first version, so learners cannot alter it.
// Collection: users/{userId}/lessonProgress/{courseId--lessonId}
// Fields: courseId and lessonId (a known valid course-and-lesson pair), completedAt
// (recent server timestamp, immutable). Every completion remains private to its owner.
// Collection: learnerProgress/{userId}
// Fields: displayName (public username, 1-50), selectedCourseCount (0-3),
// totalSelectedLessons (0-9), completedLessonCount (0-totalSelectedLessons),
// updatedAt (recent server timestamp). This intentionally contains no email or
// private lesson details and is readable by authenticated learners for now.

// ===============================================================
// Assumed Data Model
// ===============================================================
// users/{uid}/documents/{documentId}: private Firebase Storage file metadata.
// users/{uid}/courseSelections/{courseId}: learner-owned selected course IDs.
// users/{uid}/lessonProgress/{courseId--lessonId}: learner-owned completion records.
// learnerProgress/{uid}: small staff-readable course/lesson totals without email addresses.
// supportBookings/{bookingId}: learner support requests. ownerUid and original request
// details are immutable; only Teacher/Admin Custom Claims can record staff responses.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Checks that the request has a Firebase Auth identity.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Ensures the user can access only their own document-library path.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Roles come only from trusted Firebase Admin SDK Custom Claims, never from Firestore or React.
    function isProgressStaff() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'teacher');
    }

    // Support staff shares the Teacher/Admin boundary, but a named helper makes booking rules readable.
    function isSupportStaff() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'teacher');
    }

    // The document ID and Storage path must agree, preventing metadata from pointing at another user's file.
    function isValidDocument(documentId) {
      return request.resource.data.keys().hasOnly([
          'name', 'storagePath', 'contentType', 'fileSize', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'name', 'storagePath', 'contentType', 'fileSize', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.storagePath is string &&
        request.resource.data.storagePath == 'documents/' + request.auth.uid + '/' + documentId &&
        request.resource.data.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.oasis.opendocument.text',
          'application/rtf',
          'text/plain'
        ] &&
        request.resource.data.fileSize is int &&
        request.resource.data.fileSize > 0 && request.resource.data.fileSize <= 10485760 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.createdAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.createdAt <= request.time;
    }

    // Requires a predictable task schema on both creates and updates.
    function isValidTask() {
      return request.resource.data.keys().hasOnly([
          'title', 'category', 'dueDate', 'priority', 'completed', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'title', 'category', 'dueDate', 'priority', 'completed', 'createdAt'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40 &&
        request.resource.data.dueDate is string &&
        request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.priority in ['low', 'medium', 'high'] &&
        request.resource.data.completed is bool &&
        request.resource.data.createdAt is timestamp;
    }

    // Limits selections to the fixed course catalogue and blocks arbitrary data from being written.
    function isValidCourseSelection(courseId) {
      return request.resource.data.keys().hasOnly([
          'courseId', 'enrolledAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'courseId', 'enrolledAt'
        ]) &&
        request.resource.data.courseId is string &&
        request.resource.data.courseId == courseId &&
        request.resource.data.courseId in [
          'web-development-basics',
          'javascript-fundamentals',
          'professional-communication'
        ] &&
        request.resource.data.enrolledAt is timestamp &&
        request.resource.data.enrolledAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.enrolledAt <= request.time;
    }

    // Ensures a completion record refers to a real lesson in its matching predefined course.
    function isKnownCourseLesson(courseId, lessonId) {
      return (courseId == 'web-development-basics' && lessonId in [
          'html-foundations', 'css-layouts', 'responsive-design'
        ]) ||
        (courseId == 'javascript-fundamentals' && lessonId in [
          'variables-values', 'conditions-loops', 'functions-events'
        ]) ||
        (courseId == 'professional-communication' && lessonId in [
          'clear-messages', 'feedback', 'professional-email'
        ]);
    }

    // Completion documents deliberately hold one lesson each, avoiding an unvalidated client-written array.
    function isValidLessonProgress(progressId) {
      return request.resource.data.keys().hasOnly([
          'courseId', 'lessonId', 'completedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'courseId', 'lessonId', 'completedAt'
        ]) &&
        request.resource.data.courseId is string &&
        request.resource.data.lessonId is string &&
        isKnownCourseLesson(request.resource.data.courseId, request.resource.data.lessonId) &&
        progressId == request.resource.data.courseId + '--' + request.resource.data.lessonId &&
        request.resource.data.completedAt is timestamp &&
        request.resource.data.completedAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.completedAt <= request.time;
    }

    // Validates the small shared summary without placing private Auth information in a broadly readable document.
    function isValidLearnerProgress() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'selectedCourseCount', 'totalSelectedLessons',
          'completedLessonCount', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'displayName', 'selectedCourseCount', 'totalSelectedLessons',
          'completedLessonCount', 'updatedAt'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 50 &&
        request.resource.data.selectedCourseCount is int &&
        request.resource.data.selectedCourseCount >= 0 && request.resource.data.selectedCourseCount <= 3 &&
        request.resource.data.totalSelectedLessons is int &&
        request.resource.data.totalSelectedLessons >= 0 && request.resource.data.totalSelectedLessons <= 9 &&
        request.resource.data.completedLessonCount is int &&
        request.resource.data.completedLessonCount >= 0 &&
        request.resource.data.completedLessonCount <= request.resource.data.totalSelectedLessons &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.updatedAt <= request.time;
    }

    // Validates every support-booking document so extra fields, very large text, and malformed data are rejected.
    function isValidSupportBooking() {
      return request.resource.data.keys().hasOnly([
          'ownerUid', 'learnerName', 'topic', 'preferredAt', 'details', 'status',
          'staffNote', 'staffUid', 'createdAt', 'updatedAt', 'staffUpdatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'ownerUid', 'learnerName', 'topic', 'preferredAt', 'details', 'status',
          'staffNote', 'staffUid', 'createdAt', 'updatedAt', 'staffUpdatedAt'
        ]) &&
        request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid.size() > 0 && request.resource.data.ownerUid.size() <= 128 &&
        request.resource.data.learnerName is string &&
        request.resource.data.learnerName.size() > 0 && request.resource.data.learnerName.size() <= 50 &&
        request.resource.data.topic in [
          'Course content', 'Assessment', 'Technical issue', 'Study plan'
        ] &&
        request.resource.data.preferredAt is timestamp &&
        request.resource.data.preferredAt >= request.time - duration.value(1, 'h') &&
        request.resource.data.preferredAt <= request.time + duration.value(366, 'd') &&
        request.resource.data.details is string &&
        request.resource.data.details.size() > 0 && request.resource.data.details.size() <= 1000 &&
        request.resource.data.status in ['requested', 'confirmed', 'completed', 'cancelled'] &&
        request.resource.data.staffNote is string && request.resource.data.staffNote.size() <= 500 &&
        request.resource.data.staffUid is string && request.resource.data.staffUid.size() <= 128 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        (request.resource.data.staffUpdatedAt == null || request.resource.data.staffUpdatedAt is timestamp);
    }

    // The learner's identity and original request cannot be silently changed by either learner or staff updates.
    function supportBookingCoreUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.learnerName == resource.data.learnerName &&
        request.resource.data.topic == resource.data.topic &&
        request.resource.data.preferredAt == resource.data.preferredAt &&
        request.resource.data.details == resource.data.details &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // Learners only withdraw active requests; they cannot overwrite a staff update or reopen a closed request.
    function isValidOwnerBookingCancellation() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerUid &&
        isValidSupportBooking() && supportBookingCoreUnchanged() &&
        request.resource.data.staffNote == resource.data.staffNote &&
        request.resource.data.staffUid == resource.data.staffUid &&
        request.resource.data.staffUpdatedAt == resource.data.staffUpdatedAt &&
        request.resource.data.updatedAt == request.time &&
        resource.data.status in ['requested', 'confirmed'] &&
        request.resource.data.status == 'cancelled';
    }

    // Staff can make only the approved state transitions and their response UID must be their trusted Auth UID.
    function isValidStaffBookingUpdate() {
      return isSupportStaff() && isValidSupportBooking() && supportBookingCoreUnchanged() &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.staffUpdatedAt == request.time &&
        request.resource.data.staffUid == request.auth.uid &&
        (
          (resource.data.status == 'requested' && request.resource.data.status in ['confirmed', 'cancelled']) ||
          (resource.data.status == 'confirmed' && request.resource.data.status in ['completed', 'cancelled'])
        );
    }

    match /users/{userId}/documents/{documentId} {
      // A learner can list and open only their own uploaded-file metadata records.
      allow read: if isOwner(userId);

      // A new record must be owned by the learner, match the strict schema, and point to its own Storage path.
      allow create: if isOwner(userId) && isValidDocument(documentId);

      // This first version does not support record edits, preventing metadata tampering.
      allow update: if false;

      // A learner can remove only their own file metadata record.
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/tasks/{taskId} {
      // A learner can list and view only the tasks stored in their own path.
      allow read: if isOwner(userId);

      // New tasks must be owned, fully valid, and created with a recent server timestamp.
      allow create: if isOwner(userId) && isValidTask() &&
        request.resource.data.createdAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.createdAt <= request.time;

      // Updates validate the whole future task document and protect its original creation date.
      allow update: if isOwner(userId) && isValidTask() &&
        request.resource.data.createdAt == resource.data.createdAt;

      // A learner can remove only a task located in their own path.
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/courseSelections/{courseId} {
      // A learner can read only the course IDs they have personally selected.
      allow read: if isOwner(userId);

      // A selection must use a known course ID and a recent server timestamp.
      allow create: if isOwner(userId) && isValidCourseSelection(courseId);

      // Learners remove and re-add a selection rather than altering its immutable enrolment data.
      allow update: if false;

      // A learner can remove only a course selection in their own Firestore path.
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/lessonProgress/{progressId} {
      // A learner can see only their own individual completion records.
      allow read: if isOwner(userId);

      // A completion must name one known lesson and use the predictable document ID created by the app.
      allow create: if isOwner(userId) && isValidLessonProgress(progressId);

      // Toggling completion uses delete-and-create, keeping completion timestamps immutable.
      allow update: if false;

      // A learner can mark only their own completion record incomplete.
      allow delete: if isOwner(userId);
    }

    match /learnerProgress/{userId} {
      // Only trusted staff claims may read every learner's shared progress summary.
      allow read: if isProgressStaff();

      // Only the owner can create or refresh their own public summary, and every write validates the whole schema.
      allow create: if isOwner(userId) && isValidLearnerProgress();
      allow update: if isOwner(userId) && isValidLearnerProgress();

      // The application has no delete action for the shared summary.
      allow delete: if false;
    }

    match /supportBookings/{bookingId} {
      // Learners must query with ownerUid == their UID; support staff can view the shared queue.
      allow read: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid) || isSupportStaff();

      // A booking always starts as a learner-owned request. Staff fields remain blank until a staff member responds.
      allow create: if isAuthenticated() && isValidSupportBooking() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.staffNote == '' &&
        request.resource.data.staffUid == '' &&
        request.resource.data.staffUpdatedAt == null &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      // A learner can cancel their own booking; Teacher/Admin claims can move it through the staff workflow.
      allow update: if isValidOwnerBookingCancellation() || isValidStaffBookingUpdate();

      // A learner may permanently remove only their own booking. Staff retain status controls but cannot delete records.
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
