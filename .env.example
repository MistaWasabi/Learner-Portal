# Copy this file to .env.local and replace every value with the settings from
# Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Add the exact URL shown in Firebase Console after creating the Realtime Database instance.
# Example: https://learner-portal-b7224-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
